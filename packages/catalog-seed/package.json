{
  "name": "@brew-bruvs/catalog-seed",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p . --noEmit false --rewriteRelativeImportExtensions --outDir dist",
    "seed": "node --env-file-if-exists=../../.env src/import.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@brew-bruvs/brew-math": "workspace:*",
    "@brew-bruvs/db": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0"
  }
}
