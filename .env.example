# Public address of this server. Used to build global URIs for recipes, batches and listings.
BASE_URL=http://localhost:8080

# Set to your corresponding source code URL when deploying a modified server.
# SOURCE_URL=https://github.com/ironbeard21/brew-bruvs

# Local server or published Compose port. The production container listens on 8080.
PORT=8080

# Postgres connection string.
DATABASE_URL=postgres://brew:change-me@localhost:5432/brew

# Password for the Compose Postgres container. Use a URL-safe random value for production.
# Keep it in sync with DATABASE_URL for local development.
POSTGRES_PASSWORD=change-me

# Optional override for the production Compose image.
# BREW_BRUVS_IMAGE=ghcr.io/ironbeard21/brew-bruvs:latest

# Optional connection for database integration tests. The role must be able to create databases.
# TEST_DATABASE_URL=postgres://brew:change-me@localhost:5432/brew

# Who can create accounts after the admin exists: open | invite
SIGNUP_MODE=invite

# Set to true when a reverse proxy (Caddy, Traefik, Nginx) sits in front of the server, so
# sign-in rate limits use the client address from X-Forwarded-For. Leave false otherwise.
TRUST_PROXY=false

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Folder with the app's static web build (absolute, or relative to where the server starts).
# Leave unset to serve only the API.
# WEB_DIR=/srv/brew-bruvs/web

# Optional single sign-on (OIDC). Set all three to turn it on.
# Register the redirect URL <BASE_URL>/api/auth/oidc/callback with your provider.
# OIDC_ISSUER=https://auth.example.com/application/o/brew-bruvs/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
