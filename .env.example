# Public address of this server. Used to build global URIs for recipes, batches and listings.
BASE_URL=http://localhost:8080

# Port the server listens on inside the container.
PORT=8080

# Postgres connection string.
DATABASE_URL=postgres://brew:change-me@localhost:5432/brew

# Who can create accounts after the admin exists: open | invite
SIGNUP_MODE=invite

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Folder with the app's static web build (absolute, or relative to where the server starts).
# Leave unset to serve only the API.
# WEB_DIR=/srv/brew-bruvs/web
