{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": []
    },
    "@brew-bruvs/catalog-seed#test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "@brew-bruvs/db#test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "@brew-bruvs/server#test": {
      "cache": false,
      "passThroughEnv": ["TEST_DATABASE_URL"]
    },
    "@brew-bruvs/brew-math#test": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
