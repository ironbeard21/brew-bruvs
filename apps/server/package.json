{
  "name": "@brew-bruvs/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit false --rewriteRelativeImportExtensions --outDir dist",
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "openapi": "node src/write-openapi.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
