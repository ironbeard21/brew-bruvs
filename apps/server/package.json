{
  "name": "@brew-bruvs/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit false --rewriteRelativeImportExtensions --outDir dist",
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "openapi": "node src/write-openapi.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@brew-bruvs/brew-math": "workspace:*",
    "@brew-bruvs/catalog-seed": "workspace:*",
    "@brew-bruvs/db": "workspace:*",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-openapi": "^1.6.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "ipaddr.js": "^2.5.0",
    "openid-client": "^6.9.1",
    "parse5": "^8.1.1",
    "robots-parser": "^3.1.1",
    "saxes": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1"
  }
}
