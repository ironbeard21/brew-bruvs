{
  "name": "@brew-bruvs/app",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "build": "expo export --platform web --output-dir dist",
    "dev": "expo start --web",
    "dev:ios": "expo start --ios",
    "dev:android": "expo start --android",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:e2e": "if [ -z \"${PLAYWRIGHT_BASE_URL:-}\" ]; then pnpm run build || exit $?; fi; playwright test"
  },
  "dependencies": {
    "@brew-bruvs/api-contract": "workspace:*",
    "@brew-bruvs/brew-math": "workspace:*",
    "@tanstack/react-query": "^5.108.2",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "happy-dom": "^21.0.4"
  }
}
