{
  "name": "brew-bruvs",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check . && node scripts/check-spdx.ts",
    "check:licenses": "node scripts/check-licenses.ts",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @brew-bruvs/db db:generate",
    "db:migrate": "pnpm --filter @brew-bruvs/db db:migrate",
    "api:generate": "pnpm --filter @brew-bruvs/api-contract generate",
    "seed": "pnpm --filter @brew-bruvs/catalog-seed seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
